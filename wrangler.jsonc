{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-gflight",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-13",
  "compatibility_flags": ["nodejs_compat"],
  // Disable the optional native addon so the HTML transport uses native fetch.
  "alias": {
    "node-libcurl": "./src/no-libcurl.ts"
  }
}
