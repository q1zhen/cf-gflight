{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-gflight",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-13",
  "compatibility_flags": ["nodejs_compat"],
  // Adapt Node-only helpers; requests and JSON parsing use Worker APIs.
  "alias": {
    "vm": "./src/bootstrap.ts",
    "undici": "./src/no-proxy.ts"
  }
}
